#!/bin/sh
#
# @name Transform Quad Plus Real RC Safe
#
# @type Quadrotor +
# @class Copter
#
# Physical plus frame, motor 1 front. SITL/Gazebo 4099 remains an X frame.
# The board orientation must match this heading; see transform_control/README.md.
#

. ${R}etc/init.d/rc.mc_defaults

param set-default MAV_TYPE 2
param set-default CA_AIRFRAME 0

# Open rotor geometry (fold progress = 0.0).
param set-default CA_ROTOR0_PX  0.140007143
param set-default CA_ROTOR0_PY  0.0
param set-default CA_ROTOR0_KM -0.05

param set-default CA_ROTOR1_PX -0.140007143
param set-default CA_ROTOR1_PY  0.0
param set-default CA_ROTOR1_KM -0.05

param set-default CA_ROTOR2_PX  0.0
param set-default CA_ROTOR2_PY -0.140007143
param set-default CA_ROTOR2_KM  0.05

param set-default CA_ROTOR3_PX  0.0
param set-default CA_ROTOR3_PY  0.140007143
param set-default CA_ROTOR3_KM  0.05

param set-default CA_ROTOR_COUNT 4

# Holybro 6C mini real wiring:
# - Tekko32 F4 4in1 ESC motor signals on AUX1..AUX4.
# - One folding servo on MAIN1, driving the sun gear.
param set-default PWM_AUX_FUNC1 101
param set-default PWM_AUX_FUNC2 102
param set-default PWM_AUX_FUNC3 103
param set-default PWM_AUX_FUNC4 104

# Folding actuator on MAIN1 via Peripheral via Actuator Set 1.
# transform_control output pwm_open_high maps progress 0 -> 1200 us, 1 -> 750 us.
param set-default PWM_MAIN_TIM0 50
param set-default PWM_MAIN_FUNC1 301
param set-default PWM_MAIN_DIS1 1200
param set-default PWM_MAIN_MIN1 750
param set-default PWM_MAIN_MAX1 1200
param set-default PWM_MAIN_FAIL1 1200

# VrB on RC channel 6 controls fold progress; SwA on channel 7 enables morphing.
param set-default RC_MAP_AUX1 6
param set-default RC_MAP_AUX2 7

param set-default MC_AIRMODE 2

transform_control geometry plus
transform_control source rc_aux
transform_control output pwm_open_high
transform_control limit 0.30
transform_control transition 6.0
transform_control start
